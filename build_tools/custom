cmake .. -DCMAKE_INSTALL_PREFIX=$CONDA_PREFIX \
         -DOPENMM_DIR=$CONDA_PREFIX \
         -DCMAKE_PREFIX_PATH=$CONDA_PREFIX/lib/python3.13/site-packages/torch/share/cmake
make -j$(nproc)
make install
make PythonInstall


